{
  "name": "cmd-manager",
  "productName": "CMD Manager",
  "version": "1.0.0",
  "description": "Lưu, quản lý và chạy các chuỗi lệnh cmd cục bộ trên Windows",
  "main": "src/main.js",
  "author": "Toanf2103",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toanf2103/cmd-manager.git"
  },
  "homepage": "https://github.com/Toanf2103/cmd-manager#readme",
  "bugs": {
    "url": "https://github.com/Toanf2103/cmd-manager/issues"
  },
  "keywords": ["electron", "windows", "command-manager", "terminal"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/app-main.js && node --check src/preload.js && node --check src/engine.js && node --check src/runner.js && node --check src/shells.js && node --check src/renderer/app.js",
    "build": "electron-builder --win nsis portable --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:setup": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "local.cmdmanager.app",
    "productName": "CMD Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CMD Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "CMD-Manager-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
